# Names only. For local development run pnpm local:setup, which creates ignored .dev.vars.
# Hosted values belong in the deployment environment, never in browser code.
PARKMYCAR_TRUSTED_SITES_GATEWAY=0
PARKMYCAR_ALLOW_BOOTSTRAP=0
PARKMYCAR_STATUS_TTL_MINUTES=15
RATE_LIMIT_SALT=replace-with-a-cryptographically-random-secret

# Optional HTTPS Photon-compatible service; default is the low-volume public Photon service.
PARKMYCAR_PHOTON_BASE_URL=https://photon.komoot.io
